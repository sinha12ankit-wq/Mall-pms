# Copy to .env for local development. Never commit real secrets.

# Schema owner: used by migrations and seeds.
DATABASE_URL=postgres://mallpms:mallpms@localhost:5432/mallpms
# Application role: used by the API, always subject to row-level security.
APP_DATABASE_URL=postgres://mallpms_app:mallpms_app@localhost:5432/mallpms

# API
API_PORT=4000
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000

# Web
API_URL=http://localhost:4000

# Dev seed password for the demo users.
SEED_PASSWORD=ChangeMe!2026
