{
  "name": "@mall-pms/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@mall-pms/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "~0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11",
    "tsx": "^4.23.15"
  }
}
